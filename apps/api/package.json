{
  "name": "@tender-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js --max-warnings=0",
    "test": "vitest run",
    "etenders:scan": "tsx src/scripts/etendersScan.ts",
    "etenders:smoke": "tsx src/scripts/etendersSmoke.ts",
    "ai:smoke": "tsx src/scripts/aiSmoke.ts",
    "ai:qualification:smoke": "tsx src/scripts/qualificationAiSmoke.ts",
    "ai:embedding:smoke": "tsx src/scripts/embeddingSmoke.ts",
    "ai:proposal:smoke": "tsx src/scripts/proposalAiSmoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@supabase/supabase-js": "2.45.4",
    "@tender-os/constants": "workspace:*",
    "@tender-os/schemas": "workspace:*",
    "@tender-os/types": "workspace:*",
    "@tender-os/utilities": "workspace:*",
    "docx": "^9.1.0",
    "dotenv": "16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "5.0.0",
    "file-type": "^22.0.2",
    "mammoth": "^1.12.2",
    "openai": "4.104.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "playwright-core": "1.56.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.9",
    "@types/pg": "8.11.10",
    "jszip": "^3.10.2",
    "light-my-request": "6.4.0",
    "pg": "8.13.1",
    "tsup": "8.3.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
