# Tender Intelligence OS — API server environment
# Copy this file to .env and fill in real values. Never commit .env.
# See docs/SECURITY.md for the full rationale on secret handling.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-free single origin for the frontend dev server; tighten in production.
CORS_ORIGIN=http://localhost:5173

# --- Supabase (server-side only) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
# Service role key: full-privilege server-side key. NEVER expose to the
# browser, never prefix with VITE_, never log it. Used only by apps/api
# and background workers for privileged operations (RLS bypass for
# system-level writes, admin tasks). See docs/SECURITY.md §4.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# --- AI (OpenAI) — not used until Phase 7+, placeholder only ---
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Kept configurable per docs/DECISIONS.md 2026-09-10 embedding provider addendum.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Background jobs (Redis + BullMQ) — not used until later phases ---
REDIS_URL=redis://localhost:6379

# --- Scraping (Apify) — not used until Phase 4/5 ---
APIFY_TOKEN=REPLACE_WITH_APIFY_TOKEN
