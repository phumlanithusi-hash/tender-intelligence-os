# Tender Intelligence OS — web (frontend) environment
# Copy this file to .env.local and fill in real values. Never commit
# .env.local. Vite exposes ONLY variables prefixed VITE_ to the
# browser bundle — this is the entire secret boundary on this side;
# never add a non-VITE_-prefixed secret expecting it to be private,
# and never add a service-role or other privileged key here at all,
# under any variable name. See docs/SECURITY.md §4.

# Project Settings -> API in the Supabase dashboard.
# These are the PUBLIC url + anon key — safe to ship to the browser
# because Row Level Security (docs/DATABASE.md §5) is the real
# access boundary, not key secrecy.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Base URL of the @tender-os/api server.
VITE_API_BASE_URL=http://localhost:4000
